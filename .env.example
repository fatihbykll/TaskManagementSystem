# ╔═══════════════════════════════════════════════════════════╗
# ║  Gerçek değerleri: cp .env.example .env  →  .env düzenle ║
# ║  .env ASLA git'e commit edilmez!                          ║
# ╚═══════════════════════════════════════════════════════════╝
# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=TaskManagementDb
# ── Backend (JWT) ──────────────────────────────────────────────────────
# Güvenli key üret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_KEY
JWT_ISSUER=TaskManagementAPI
JWT_AUDIENCE=TaskManagementClient
JWT_EXPIRY_MINUTES=60
ADMIN_EMAIL=admin@yourdomain.com
# ── SSL / Domain ───────────────────────────────────────────────────────
DOMAIN=yourdomain.com
CERTBOT_EMAIL=ssl@yourdomain.com
ASPNETCORE_ENVIRONMENT=Production
