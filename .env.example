# ════════════════════════════════════════════════════════════════
# Task Management System — Environment Variables
# Kullanım: cp .env.example .env  (sonra gerçek değerleri girin)
# UYARI: .env dosyasını asla Git'e commit etmeyin!
# ════════════════════════════════════════════════════════════════
# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=TaskManagementDb
# ── JWT (minimum 32 karakter, büyük/küçük/rakam karışık) ─────
# Üretmek için: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_minimum_32_char_secret_key_here
JWT_ISSUER=TaskManagementAPI
JWT_AUDIENCE=TaskManagementClient
JWT_EXPIRY_MINUTES=60
# ── Uygulama ──────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
# ── Domain (production deploy için) ──────────────────────────
DOMAIN=yourdomain.com
CERTBOT_EMAIL=your-email@yourdomain.com
